# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN ĐGNL 2026
# ==========================================

# Port chạy Web Server (mặc định: 8050)
PORT=8050

# API Keys cho Google Gemini (Hỗ trợ 1 hoặc nhiều key cách nhau bằng dấu phẩy để tự động xoay tua)
# Lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Hoặc nhiều keys:
# GEMINI_API_KEY=key_1,key_2,key_3,key_4

# Mô hình Gemini ưu tiên suy luận nhanh (mặc định: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest
